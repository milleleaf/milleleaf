# Build output
target/
node_modules/
__pycache__/
*.pyc
.DS_Store

# Old snapshots and tool state (not project source)
_to_delete/
Claude outputs/
.omx/

# Licensed standards (BSI, ISO, …): never redistributed, so never in a repo that could be pushed.
# The index of what's there stays tracked.

# GSD planning lives outside the repo (symlink), and local agent settings stay local
.planning
.claude/settings.local.json

# Secrets: keys and env files never go in git
.env
.env.*
!.env.example
*.key
*.pem

# Generated by examples/hello-table/run.sh (re-made on every run; the inputs and fixtures are tracked)
examples/hello-table/board-pack.pdf
examples/hello-table/composed-*.html
examples/hello-table/report.docx
examples/hello-table/report-edited.docx
examples/hello-table/report-edited.odt
examples/hello-table/finance.xlsx
examples/hello-table/finance-edited.xlsx
examples/hello-table/finance-edited.ods
examples/hello-table/deck.pptx
examples/hello-table/deck-edited.pptx
examples/hello-table/deck-edited.odp
